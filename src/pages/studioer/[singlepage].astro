---
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import "../../styles/global.css"
import "../../styles/custom.css"
import wave from "../../assets/wave.png"
import { Image } from "astro:assets";
export async function getStaticPaths() {
const apiurl = "https://ytvapyezsyjphhrmwfsk.supabase.co/rest/v1/";
const TableName = "studios";

const key = "sb_publishable_nUGu7E0X6O-02X9AXpXoJA_qtbHWKwE";
const options = {
	headers: {
		apikey: key
	},
};

const response = await fetch(apiurl + TableName, options);
const studios = await response.json();


    return studios.map((studio) => {
        return {
            params: { singlepage: studio.slug },
            props: { studio },
        };
    });
}

const { studio } = Astro.props;
---
<Header/>
<section>
    <article class="hero">
        <img src={studio.banner_img}/>
        <div class="title">
            <h1 class="italic">{studio.name}</h1>
            <h1 class="align-end">studio</h1>
        </div>
    </article>
	<Image class="wave-img" src={wave} alt="Pink bølge som baggrunds element" />
</section>
<section class="desktop_1-1">
    <article class="txt-box">
        <div class="flex">
            <h2 class="italic">Book&nbsp;</h2>
            <h2 class="italic">{studio.name}&nbsp;</h2>
            <h2><strong>studioet</strong></h2>
        </div>
        <p>Du kan booke studiet mandag-fredag mellem kl. 9-15. Det er kun muligt at booke det 1 dag ad gangen. Når du har booket studiet, kan du afhente nøglen i Tech & Story Lab samme dag.  Du finder os på Guldbergsgade 29N lige bag receptionen i stueetagen. Vi står klar til at hjælpe dig og kan også vejlede dig i, om du skal have yderligere udstyr til dit projekt.</p>
    </article>
    <article class="info-box">
        <div class="flex">
            <h4 class="italic">{studio.name}&nbsp;</h4><h4><strong>studio</strong></h4>
        </div>
        <p><strong>Lab</strong></p>
        <p>Tech & Story</p>
        <span class="line"></span>
        <p><strong>Tilgængeligt for</strong></p>
        <p>alle</p>
        <span class="line"></span>
        <a href="" class="cta-btn">
            <p class="italic">book studiet&nbsp;</p>
            <p><strong>online</strong></p>
        </a>
</article>
</section>
<section>
    <article>
        <div class="flex">
        <h2 class="italic">I tvivl om hvor du skal starte?&nbsp;</h2>
        <h2><strong>Se hvad andre har lånt</strong></h2>
    </div>
    </article>
</section>
<Footer/>

<style>
    .hero {
        display: grid;
        background-color: var(--color-pink300);
        padding-bottom: 3rem;
        img {
            grid-column: 1/2;
            grid-row: 1/2;
        }
        .title {
        margin-inline: 25%;
         grid-column: 1/2;
         grid-row: 1/2;
         align-content: center;
        }
    }
    h1 {
        color: var(--color-light);
    }
    h1.align-end {
        text-align: end;
    }
    .flex {
        display: flex;
        flex-wrap: wrap;
    }
    .wave-img {
        position: absolute;
        width: 100%;
        z-index: -1;
    }
    .info-box {
        display: grid;
        background-color: var(--color-purple950);
        color: var(--color-pink300);
        padding: 2rem;
        margin: 1.5rem;
        border-radius: 20px;
        max-width: 314px;
        justify-self: center;
        width: 100%;
        h4 {
            padding-bottom: 1rem;
        }
    }
    .line {
        display: block;
        height: 1px;
        background-color: var(--color-pink200);
        margin-block: .75rem;
    }
    a.cta-btn {
        display: flex;
        background-color: var(--color-yellow300);
        height: 48px;
        width: fit-content;
        padding-inline: 1.5rem;
        align-items: center;
        border-radius: 50px;
        justify-self: center;
        transition: .3s ease-out;
    }
    a.cta-btn:hover {
        background-color: var(--color-dark);
        color: var(--color-light);
        padding-inline: 2rem;
    }
    .txt-box {
        display: grid;
        gap: 1rem;
        padding-inline: 1.5rem;
        padding-block: 2rem;
    }
    @media (min-width: 800px) {
        .desktop_1-1 {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }
    }
</style>