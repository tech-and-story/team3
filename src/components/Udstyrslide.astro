---
// const {headline, headlinebold, description, image, alt} = Astro.props;
// import { Image } from 'astro:assets';
const {data} = Astro.props;
---

<article>
  <img src={data.image} alt=`Image of ${data.headline} ${data.headlinebold} udstyr` />
    <div class="flex">
  <h4 class="serif italic">{data.headline}&shy;{data.headlinebreak}</h4><h4>{data.headlinebold}</h4>
</div>
  <p>{data.description}</p>
</article>

<style>
  article {
    display: grid;
    grid-template-rows: auto auto 1fr;
    img {
        border: 2px solid var(--color-purple950);
        border-radius: 10px;
    }
  }
  .flex {
    display: flex;
    flex-wrap: wrap;
    /* word-break: break-all; */
  }
</style>