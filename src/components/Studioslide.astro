---
const {headline, description, image} = Astro.props;
import { Image } from 'astro:assets';
const { data } = Astro.props;
---

<a href=`/studioer/${data.slug}`>
  <article>
    <img src={data.image} alt=`image of ${data.name}`>
  <div class="banner">
    <div class="flex">
  <h3 class="serif italic">{data.name}&nbsp;</h3><h3>studio</h3></div>
  <p>{data.description}</p></div>
</article>
</a>

<style>
  article {
    display: grid;
    grid-template-rows: 1fr auto 1rem;
  }

  img {
    grid-column: 1/2;
    grid-row: 1/5;
    object-fit: cover;
    border-radius: 10px;
  }
  .banner {
    display: grid;
    grid-column: 1/2;
    grid-row: 2/3;
    background-color: var(--color-purple950);
    height: fit-content;
    align-self: center;
    color: var(--color-light);
    padding: 1rem 1.5rem;
    max-height: 120px;
  }
  p {
    text-wrap: wrap;
  }
  .flex {
    display: flex;
    flex-wrap: wrap;
  }
</style>