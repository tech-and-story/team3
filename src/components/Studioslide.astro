---
const {headline, description, image, alt} = Astro.props;
import { Image } from 'astro:assets';
---

<article>
  <Image src={image} alt={alt}/>
  <div class="banner">
    <div class="flex">
  <h3 class="serif italic">{headline}&nbsp;</h3><h3>studie</h3></div>
  <p>{description}</p></div>
</article>

<style>
  article {
    display: grid;
    grid-template-rows: 1fr auto 1rem;
  }

  img {
    grid-column: 1/2;
    grid-row: 1/5;
    object-fit: cover;
    border-radius: 10px;
  }
  .banner {
    display: grid;
    grid-column: 1/2;
    grid-row: 2/3;
    background-color: var(--color-purple950);
    height: fit-content;
    align-self: center;
    color: var(--color-light);
    padding: 1rem 1.5rem;
    max-height: 120px;
  }
  p {
    text-wrap: wrap;
  }
  .flex {
    display: flex;
    flex-wrap: wrap;
  }
</style>